#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <ESP32Servo.h>
#include "Adafruit_VL53L0X.h"
#include "soc/soc.h"           
#include "soc/rtc_cntl_reg.h"  

// --- Pin Definitions (ESP32-CAM Optimized) ---
#define PIN_F_SENSE   13   
#define PIN_B_SENSE   12  
#define PIN_TRIG      0    
#define PIN_ECHO      3
#define PIN_SERVO     16
#define PIN_RED_BZ    4     // Red LED, Buzzer, and Onboard Flashlight
#define PIN_GREEN     2     // Green Status LED (Onboard Blue LED)

#define I2C_SDA       14
#define I2C_SCL       15

Adafruit_VL53L0X lox = Adafruit_VL53L0X();
LiquidCrystal_I2C lcd(0x27, 16, 2);
Servo radarServo;

int pos = 0;
int sweepStep = 10; 
unsigned long lastBeep = 0;
bool bzState = false;

void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0); 
  
  Wire.begin(I2C_SDA, I2C_SCL);
  lcd.init();
  lcd.backlight();
  
  lcd.setCursor(0, 0); lcd.print("   NEURO-PATH   ");
  lcd.setCursor(0, 1); lcd.print(" BLINDSPOT SYS ");
  delay(3000);

  lcd.clear();
  lcd.print("SYSTEM BOOT...  ");
  delay(1000);
  
  pinMode(PIN_F_SENSE, INPUT_PULLDOWN);
  pinMode(PIN_B_SENSE, INPUT_PULLDOWN);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT_PULLUP); 
  pinMode(PIN_RED_BZ, OUTPUT);
  pinMode(PIN_GREEN, OUTPUT);

  lox.begin(); 
  radarServo.attach(PIN_SERVO, 500, 2400);
  lcd.clear();
}

void displayDistance(int dist, int colStart) {
  lcd.setCursor(colStart, 0);
  if (dist == -1) lcd.print("N/C  "); 
  else if (dist >= 350 || dist == 999) lcd.print("CLR  "); 
  else if (dist >= 100) {
    float meters = dist / 100.0;
    lcd.print(meters, 1); lcd.print("m  "); 
  } else {
    lcd.print(dist); lcd.print("cm "); 
  }
}

void loop() {
  int uDist = -1; 
  int lDist = -1;

  // --- 1. ULTRASONIC PING ---
  digitalWrite(PIN_TRIG, LOW); delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH); delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);
  
  long uDur = pulseIn(PIN_ECHO, HIGH, 20000); 
  if (uDur == 0) {
    if (digitalRead(PIN_ECHO) == HIGH) uDist = -1; 
    else uDist = 999; 
  } else {
    uDist = uDur * 0.034 / 2;
    if (uDist > 350) uDist = 999;
  }

  // --- 2. LASER PING ---
  Wire.beginTransmission(0x29);
  if (Wire.endTransmission() == 0) { 
    VL53L0X_RangingMeasurementData_t measure;
    lox.rangingTest(&measure, false);
    if (measure.RangeStatus != 4 && measure.RangeMilliMeter < 2000 && measure.RangeMilliMeter != 8190) {
      lDist = measure.RangeMilliMeter / 10;
    } else lDist = 999; 
  } else lDist = -1; 

  // --- 3. SERVO SAFETY LOCK ---
  if (uDist != -1) {
    if (!radarServo.attached()) radarServo.attach(PIN_SERVO, 500, 2400);
    radarServo.write(pos);
    pos += sweepStep;
    if(pos <= 0 || pos >= 180) sweepStep *= -1;
  } else radarServo.detach(); 

  // --- 4. LCD TOP LINE ---
  lcd.setCursor(0, 0);
  lcd.print("U:"); displayDistance(uDist, 2); 
  lcd.setCursor(7, 0); lcd.print("|");
  lcd.setCursor(9, 0);
  lcd.print("L:"); displayDistance(lDist, 11);

  // --- 5. SENSOR FUSION & REMOTE SENSING ---
  bool isMoving = (digitalRead(PIN_F_SENSE) == HIGH || digitalRead(PIN_B_SENSE) == HIGH);
  int minDist = 999;
  if (uDist != -1 && uDist != 999) minDist = min(minDist, uDist);
  if (lDist != -1 && lDist != 999) minDist = min(minDist, lDist);

  // --- 6. ALERT DISPATCHER ---
  lcd.setCursor(0, 1);
  if (uDist == -1 && lDist == -1) {
    lcd.print("CHECK SENSORS!  ");
    digitalWrite(PIN_RED_BZ, HIGH); // Hardware failure override
  } else if (uDist == -1) {
    lcd.print("CHECK ULTRA!    ");
    handleCombinedAlerts(minDist, isMoving);
  } else if (lDist == -1) {
    lcd.print("CHECK LASER!    ");
    handleCombinedAlerts(minDist, isMoving);
  } else {
    handleCombinedAlerts(minDist, isMoving); 
  }
  
  delay(5); 
}

void handleCombinedAlerts(int distance, bool moving) {
  if (distance < 15) {
    lcd.print("CAUTION: ALERT! ");
    digitalWrite(PIN_GREEN, LOW); // Turn off status blue LED
    
    // Danger Zone: Continuous Red LED and Buzzer
    if (moving) digitalWrite(PIN_RED_BZ, HIGH); 
    else digitalWrite(PIN_RED_BZ, LOW);
  } 
  else if (distance < 35) {
    lcd.print("CAUTION: SLOW   ");
    digitalWrite(PIN_GREEN, LOW);
    
    // Caution Zone: Synchronized Pulsing Red LED and Buzzer
    if (moving) {
      if (millis() - lastBeep > 150) {
        bzState = !bzState;
        digitalWrite(PIN_RED_BZ, bzState);
        lastBeep = millis();
      }
    } else {
      digitalWrite(PIN_RED_BZ, LOW);
    }
  } 
  else {
    lcd.print("STATUS: CLEAR   ");
    digitalWrite(PIN_GREEN, HIGH); // Onboard Blue LED indicates system is clear
    digitalWrite(PIN_RED_BZ, LOW);  // All warnings off
  }
}
