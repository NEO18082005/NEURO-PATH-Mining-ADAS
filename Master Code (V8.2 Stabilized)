#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <ESP32Servo.h>
#include "Adafruit_VL53L0X.h"
#include "soc/soc.h"           // Required for Brownout fix
#include "soc/rtc_cntl_reg.h"  // Required for Brownout fix

// --- Pin Definitions ---
#define PIN_F_SENSE   13   
#define PIN_B_SENSE   12  
#define PIN_TRIG      0    
#define PIN_ECHO      3
#define PIN_SERVO     16
#define PIN_RED_BZ    1    
#define PIN_YELLOW    4    
#define PIN_GREEN     2    

#define I2C_SDA       14
#define I2C_SCL       15

// Objects
Adafruit_VL53L0X lox = Adafruit_VL53L0X();
LiquidCrystal_I2C lcd(0x27, 16, 2);
Servo radarServo;

// Variables
int pos = 0;
int sweepStep = 2;
unsigned long lastBeep = 0;

void setup() {
  // Disable brownout detector to prevent reboots during servo peaks
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0); 
  
  Serial.begin(115200);
  
  // Initialize I2C and LCD
  Wire.begin(I2C_SDA, I2C_SCL);
  lcd.init();
  lcd.backlight();
  
  // BOOT SEQUENCE
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("   NEURO-PATH   ");
  lcd.setCursor(0, 1);
  lcd.print(" BLINDSPOT SYS  ");
  delay(3000);
  
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("SYSTEM BOOT...  ");
  delay(1000);
  
  // Pin Modes
  pinMode(PIN_F_SENSE, INPUT_PULLDOWN);
  pinMode(PIN_B_SENSE, INPUT_PULLDOWN);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
  pinMode(PIN_RED_BZ, OUTPUT);
  pinMode(PIN_YELLOW, OUTPUT);
  pinMode(PIN_GREEN, OUTPUT);

  if (!lox.begin()) {
    lcd.clear();
    lcd.print("LASER ERROR");
    while(1);
  }
  
  radarServo.attach(PIN_SERVO, 500, 2400);
  lcd.clear();
}

void loop() {
  // 1. Radar Sweep Execution
  radarServo.write(pos);
  pos += sweepStep;
  if(pos <= 0 || pos >= 180) sweepStep *= -1;

  // 2. Trajectory/Motion Analysis
  bool isMoving = (digitalRead(PIN_F_SENSE) == HIGH || digitalRead(PIN_B_SENSE) == HIGH);

  // 3. Sensor Fusion (Ultrasonic + Laser)
  digitalWrite(PIN_TRIG, LOW); delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH); delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);
  long uDur = pulseIn(PIN_ECHO, HIGH, 25000);
  int uDist = (uDur > 0) ? uDur * 0.034 / 2 : 999;

  VL53L0X_RangingMeasurementData_t measure;
  lox.rangingTest(&measure, false);
  int lDist = (measure.RangeStatus != 4) ? measure.RangeMilliMeter / 10 : 999;

  int minDist = min(uDist, lDist);

  // 4. Cockpit Telemetry Update
  lcd.setCursor(0, 0);
  lcd.print("U:"); lcd.print(uDist); 
  lcd.print(" L:"); lcd.print(lDist);
  lcd.print(" cm  ");

  // 5. Caution & Alert Engine
  lcd.setCursor(0, 1);
  
  if (minDist < 15) { 
    lcd.print("CAUTION: ALERT! ");
    digitalWrite(PIN_GREEN, LOW);
    digitalWrite(PIN_YELLOW, LOW);
    if (isMoving) digitalWrite(PIN_RED_BZ, HIGH); 
    else digitalWrite(PIN_RED_BZ, LOW);
  } 
  else if (minDist >= 15 && minDist < 35) { 
    lcd.print("CAUTION: SLOW   ");
    digitalWrite(PIN_GREEN, LOW);
    digitalWrite(PIN_YELLOW, HIGH);
    if (isMoving) {
      if (millis() - lastBeep > 200) {
        digitalWrite(PIN_RED_BZ, !digitalRead(PIN_RED_BZ));
        lastBeep = millis();
      }
    } else digitalWrite(PIN_RED_BZ, LOW);
  } 
  else { 
    lcd.print("STATUS: CLEAR   ");
    digitalWrite(PIN_GREEN, HIGH);
    digitalWrite(PIN_YELLOW, LOW);
    digitalWrite(PIN_RED_BZ, LOW);
  }

  delay(20); 
}
